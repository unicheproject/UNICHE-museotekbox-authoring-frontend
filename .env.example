# Museotek Box Frontend — local/dev configuration. Copy to `.env`; NEVER commit `.env`.
# No secrets here: the SPA is a public PKCE client. These are browser-facing URLs/ids.

# Published host port for the containerised SPA (dev `npm run dev` uses 5173 separately).
FRONTEND_PORT=8083

# IdP issuer base — MUST equal the value the Museotek Box Backend validates (issuer-consistency rule).
IDP_URL=https://idp.uniche-eccch.eu
REALM=uniche
CLIENT_ID=museotek-box-web
AUDIENCE=uniche-platform

# Museotek Box Backend base URL as reachable from the BROWSER (its published host port).
BACKEND_URL=http://localhost:8080
